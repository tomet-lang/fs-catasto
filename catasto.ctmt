::use(catasto, version: "1.0.0")
::upstream(
  vocabularies: catasto.git("https://github.com/tomet-lang/vocabularies.git", rev: main, root: vocabularies)
  commonfiles:  catasto.git("https://github.com/tomet-lang/commonfiles.git", rev: main, root: base)
)
::zone(
  // --- Tomet ---
  "tmtroot/schema/blueprints": (allow: ("<?kebab>.blueprint.tmt"))
  "tmtroot/dev/dropped": (allow: ("<?int>-<?kebab>.adr.tmt"))
  // --- Crates ---
  "crates/<?kebab>": (
    require: ("Cargo.toml", "src")
    allow:   ("Cargo.toml", "src")
  )
  "crates/<?kebab>/src": (
    files: (allow: ("<?snake>.rs"))
    dirs: (allow: ("<?snake>"))
  )
  // --- Nix ---
  "nix": (
    recursive: true
    files: (allow: ("<?kebab>.nix"))
    dirs: (allow: ("<?kebab>"))
))

// --- Vocabularies ---
"tmtroot/schema/vocabularies/rust@1.0.0.vocabulary.tmt": catasto.upstream(vocabularies, path: "rust/rust@1.0.0.vocabulary.tmt")
"tmtroot/schema/vocabularies/writ@1.0.0.vocabulary.tmt": catasto.upstream(vocabularies, path: "writ/writ@1.0.0.vocabulary.tmt")

// --- Environment ---
".editorconfig":  catasto.upstream(commonfiles, path: ".editorconfig")
".envrc":         catasto.upstream(commonfiles, path: ".envrc")
"LICENSE-APACHE": catasto.upstream(commonfiles, path: "LICENSE-APACHE")
"LICENSE-MIT":    catasto.upstream(commonfiles, path: "LICENSE-MIT")

// --- Vendor Config ---
".gitattributes":               catasto.upstream(commonfiles, path: ".gitattributes")
".github/workflows/nix-ci.yml": catasto.upstream(commonfiles, path: ".github/workflows/nix-ci.yml")
"nix/formatter.nix":            catasto.upstream(commonfiles, path: "nix/formatter.nix")
