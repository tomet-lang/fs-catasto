::kind(vocabulary)
::vocabulary(catasto, version: "0.1.0")
::attribute(
  upstream: (
    about: | Git repositories, each named once (`name: catasto.git(url, rev: main, path: dir)`), that entries take files or directories from with `catasto.upstream(name, path: ...)`.
    host: ctmt
  )
  zone: (
    about: | Directory rules, keyed by a workspace path pattern: what a directory must hold, may hold, and must not hold.
    host: ctmt
))
::constructor(
  git: (
    about: | A file, directory, or repository in Git.
    args: (
      url: (
        type: string
        positional: true
        required: true
        about: | Repository URL (`https://` URL or workspace-relative path).
      )
      rev: (
        type: string
        default: main
        about: | Pinned tag, branch, or commit hash. Quote numeric revisions (e.g. `rev: "1.2"`).
      )
      path: (
        type: string
        about: | Location of the file or directory inside the Git repository, relative to the repository root. Omit to take the repository root.
  )))
  upstream: (
    about: | A file or directory from an upstream repository declared in `::upstream(...)`.
    args: (
      upstream: (
        type: string
        positional: true
        required: true
        about: | Name of an upstream declared in `::upstream(...)`.
      )
      path: (
        type: string
        about: | Location of the file or directory relative to the upstream's `path` (or the repository root). Omit to take the upstream's location as a whole.
  )))
  local: (
    about: | A file on the local filesystem, relative to the workspace root.
    args: (
      path: (
        type: string
        positional: true
        required: true
        about: | Path to the local source file, relative to the workspace root.
  ))))
