@kind(config)
@meta{id: doc-default-config}
@config{
  macros: {
    copyright: "(C) 2026 Tomet Projects"
    generated_by: "<!-- Generated from ${1}. Edit that, then `tomet export .`. -->"
  }
  vocabularies: list(
    "tmtroot/schema/vocabularies/writ@1.0.0.vocabulary.tmt",
    "tmtroot/schema/vocabularies/rust@1.0.0.vocabulary.tmt",
  )
  format: {
    meta: { always_newline: true }
    heading: { space_inside_brackets: true }
    table: { adjust_width: auto, max_col_width: 50 }
    link: {
      no_space: true
      group_order: "[]()"
    }
    quote: { always_newline: true }
    callout: {
      style: { content: block }
    }
    list: {
      multiline: {
        style: { content: box }
      }
    }
  }
}
